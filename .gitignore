# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Environments
.env
.venv
env/
venv/
ENV/

# Data and Cache (preserve fixtures and gitkeeps, ignore local cache)
backend/data/cache/*.json
!backend/data/cache/.gitkeep
backend/data/fixtures/*.json
!backend/data/fixtures/.gitkeep

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
