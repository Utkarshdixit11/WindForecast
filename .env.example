# ==========================================
# UK Wind Forecast Accuracy Analytics Config
# ==========================================

# Backend Settings
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_HTTP_TIMEOUT=30.0
DEFAULT_START_DATE=2026-01-01
DEFAULT_END_DATE=2026-01-31
DEFAULT_CUTOFF_TYPE=day_ahead_fixed
DEFAULT_CUTOFF_TIME_UK=11:00
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://your-frontend.vercel.app,*
DEBUG=False

# Frontend Settings (optional: specify backend URL if frontend is deployed on separate domain)
# When empty, frontend uses relative /api path (proxied by Nginx or Vite)
VITE_API_URL=
